# ============================================================
# CINTESP WEB — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com suas chaves.
# NUNCA versione o .env com valores reais.
# ============================================================

# Supabase — pegue em: Project Settings > API (https://app.supabase.com)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key-aqui

# Enquanto o Supabase não estiver configurado, o app roda com dados
# de exemplo (mock). Deixe "true" para usar mock; "false" para usar o banco.
VITE_USE_MOCK=true

# Agenda do Google embutida na tela "Agenda do Dia" (opcional).
# Google Agenda > Configuracoes > Integrar agenda > copie o src do iframe.
VITE_GOOGLE_CALENDAR_URL=
