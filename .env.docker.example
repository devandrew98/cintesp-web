# ============================================================
# CINTESP WEB — variáveis do DEPLOY (VPS).
# Copie para ".env" (ao lado do docker-compose.yml) e preencha.
# NÃO comitar o .env preenchido.
# ============================================================

# ---- Domínios (crie os registros A no DNS apontando para o IP da VPS) ----
APP_DOMAIN=app.seu-dominio.com.br
API_DOMAIN=api.seu-dominio.com.br

# E-mail para o Let's Encrypt (avisos de certificado)
ACME_EMAIL=voce@seu-dominio.com.br

# ---- Ligação do front com o Supabase self-hosted ----
# URL pública da API do Supabase = o API_DOMAIN acima (com https://)
VITE_SUPABASE_URL=https://api.seu-dominio.com.br
# anon key gerada no setup do Supabase self-hosted (arquivo .env do Supabase)
VITE_SUPABASE_ANON_KEY=COLE_A_ANON_KEY_DO_SEU_SUPABASE
# Sempre "false" em produção (usa o banco real)
VITE_USE_MOCK=false

# ---- Onde o Caddy encontra o gateway do Supabase (Kong) ----
# Se o Supabase self-hosted roda na MESMA VPS (compose oficial), normalmente é:
SUPABASE_UPSTREAM=host.docker.internal:8000
